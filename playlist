playlist = { 
           'nombre': '', 
            'canciones':[]
            }
playlist['canciones'] = []#crea un diccionario
def app():
    agregar_playlist= True #cambio : por =
    while agregar_playlist:
        nombre_playlist = input('como desear nombrar tu playlist')
        
        if nombre_playlist:
            playlist['nombre'] = nombre_playlist
            agregar_playlist = False
            agregar_canciones()
            mostrar_resumen()
def agregar_canciones():
    print('Agregar canciones  a la playlist',playlist['nombre'])
    while True:
        cancion = input('ingrasa el nombre de la cancion o x pa irte:')
        if cancion.lower()== 'x': # se le pusieron parentesis a lower
            break
        
        playlist['canciones'].append(cancion)
        print('Cancion agrgada',cancion)
    print('playlist completa')
    print(playlist)
    
def mostrar_resumen():
    print('playlist', playlist['nombre'])
    print('canciones de la playlist\r\n')
    
    for cancion in playlist['canciones']:
        print(cancion)






app()




curso = {}
curso['alumnos'] = []
def escuela():
    agregar_curso = True
    while agregar_curso:
        nombre_curso = input('Cual es el nombre del curso')
        if nombre_curso:
            curso['nombre'] = nombre_curso
            agregar_curso = False
            agregar_alumnos()
            mostrar_resumen()
def agregar_alumnos():
    while True:
        nombre = input('Ingresa nombres de los alumnos o q para salir:')
        if nombre.lower() == 'q': 
            break
        curso['alumnos'].append(nombre)
    print('lista del curso terminado')
    
def mostrar_resumen():
    print('Curso', curso['nombre'])
    print('alumnos\r\n')
    
    for nombre in curso['alumnos']:
        print(nombre)





escuela()
