Notas = []
def Promedio_estudiante ():
    Nombre = input('ingrese el nombre del estudiante')
    x = float(input('Cuantas materias Cursa el estudiante?'))
    while True:
        materia = input('ingrese el nombre de la materia o sumar para ver el promedio:')
        if materia =='sumar':
            break
        notas = float(input('escribe la nota de la materia '))
        Notas.append(notas)
        
    print(f'el promedio final de  {Nombre} es:')
    total = sum(Notas)
    print(total//x)

Promedio_estudiante()
